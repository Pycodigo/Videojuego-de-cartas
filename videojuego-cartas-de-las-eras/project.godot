; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dominio Cronológico"
run/main_scene="uid://bhv68ga71uery"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GlobalTest="*res://Scripts/Test/global_prueba.gd"
GlobalConfigFile="*res://Scripts/config_file.gd"
Global="*res://Scripts/global.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray()

[internationalization]

locale/translations=PackedStringArray("res://Translations/ui.es.translation", "res://Translations/ui.en.translation", "res://Translations/ui.gl.translation", "res://Translations/cards.es.translation", "res://Translations/cards.en.translation", "res://Translations/cards.gl.translation")
locale/fallback="es"

[plugins]

ai_assistant_hub/llm_api="ollama_api"
ai_assistant_hub/preferences/thinking_target=0
ai_assistant_hub/preferences/skip_greeting=false
ai_assistant_hub/preferences/always_scroll_to_bottom=false

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
